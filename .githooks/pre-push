#!/usr/bin/env bash
set -euo pipefail

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  case "$remote_ref" in
    refs/heads/internal/*|refs/heads/backup/*|refs/heads/experiment/*|refs/heads/exp/*|refs/heads/eval)
      printf 'Keep internal and experimental branches in cade-internal: %s\n' "$remote_ref" >&2
      exit 1
      ;;
  esac
  if ! git rev-parse --verify 'refs/remotes/origin/dev^{commit}' >/dev/null 2>&1; then
    printf 'Fetch origin/dev before pushing.\n' >&2
    exit 1
  fi
  blocked="$(git log --format= --name-only --no-renames --diff-filter=ACM \
    "$local_sha" --not --remotes=origin -- \
    benchmarks .cade e2e-results benchmark-results eval-results evals)"
  if [[ -n "$blocked" ]]; then
    printf 'New public history contains internal assets:\n%s\n' "$blocked" >&2
    exit 1
  fi
done
